# Copiar como .env.local para desarrollo. En Vercel se cargan en Settings > Environment Variables.

# Base de datos Postgres (Neon desde el Marketplace de Vercel). Si se deja vacía,
# en desarrollo se usa una base local en la carpeta .data/
DATABASE_URL=

# Login con Google (Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Dominio de mail permitido para entrar
AUTH_DOMINIO=knownonline.com

# Clave de la API de Claude, para procesar minutas
ANTHROPIC_API_KEY=
